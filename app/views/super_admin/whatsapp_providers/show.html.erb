<% content_for(:title) { @definition.name } %>
<%= render 'mobile_navigation' %>
<section class="p-6 max-w-3xl space-y-6">
  <h1 class="text-2xl font-semibold"><%= @definition.name %></h1>
  <p><%= t('whatsapp_providers.disable_notice') %></p>
  <%= form_with url: super_admin_whatsapp_provider_path(@definition.id), method: :patch, scope: :configuration, class: 'space-y-4' do |form| %>
    <div><%= form.check_box :enabled, checked: @configuration.enabled? %> <%= form.label :enabled, t('whatsapp_providers.enabled') %></div>
    <% if @definition.session && @definition.id != 'zapi' %>
      <div><%= form.label :base_url, t('whatsapp_providers.base_url') %><%= form.url_field :base_url, value: @configuration.effective_settings['base_url'], class: 'w-full', autocomplete: 'off' %></div>
      <div><%= form.check_box :allow_private_network, checked: @configuration.settings['allow_private_network'] == true %> <%= form.label :allow_private_network, t('whatsapp_providers.private_network') %></div>
    <% end %>
    <% if @definition.id == 'baileys' %>
      <div><%= form.label :client_name, t('whatsapp_providers.client_name') %><%= form.text_field :client_name, value: @configuration.settings['client_name'], class: 'w-full' %></div>
      <div><%= form.label :api_key, t('whatsapp_providers.api_key') %><%= form.password_field :api_key, value: '', placeholder: @configuration.effective_settings['api_key'].present? ? '••••••••' : '', autocomplete: 'new-password', class: 'w-full' %></div>
      <p><%= t('whatsapp_providers.keep_secret') %></p>
    <% else %>
      <p><%= t('whatsapp_providers.test_per_inbox') %></p>
    <% end %>
    <%= form.submit t('whatsapp_providers.save'), data: { disable_with: t('whatsapp_providers.saving'), confirm: t('whatsapp_providers.confirm') } %>
  <% end %>
  <% if @definition.id == 'baileys' && @configuration.persisted? %>
    <%= button_to t('whatsapp_providers.test'), test_connection_super_admin_whatsapp_provider_path(@definition.id), method: :post, data: { disable_with: t('whatsapp_providers.testing') } %>
  <% end %>
</section>
