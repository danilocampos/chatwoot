<% content_for(:title) { t('whatsapp_providers.title') } %>
<%= render 'mobile_navigation' %>
<section class="p-6 space-y-6">
  <h1 class="text-2xl font-semibold"><%= t('whatsapp_providers.title') %></h1>
  <p><%= t('whatsapp_providers.disable_notice') %></p>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <% @providers.each do |provider| %>
      <% config = @configurations[provider.id] %>
      <article class="border rounded-lg p-4 space-y-2">
        <h2 class="text-lg font-medium"><%= link_to provider.name, super_admin_whatsapp_provider_path(provider.id) %></h2>
        <p><%= t(config ? (config.enabled? ? 'whatsapp_providers.enabled' : 'whatsapp_providers.disabled') : (provider.default_enabled ? 'whatsapp_providers.enabled' : 'whatsapp_providers.disabled')) %></p>
      </article>
    <% end %>
  </div>
</section>
